{
  "domain": "invitation",
  "cases": [
    {
      "name": "an invitation holds its address while open, its token for 7 days",
      "aggregate": "invitation",
      "aggregateId": "i1",
      "tenant": "t1",
      "now": 1000000,
      "given": [],
      "when": {
        "type": "CreateInvitation",
        "data": {
          "email": "Bob@Example.com",
          "groups": [
            {
              "group": "g1"
            }
          ]
        }
      },
      "then": [
        {
          "type": "InvitationCreated",
          "data": {
            "email": "bob@example.com",
            "groups": [
              {
                "group": "g1",
                "scope": null
              }
            ],
            "owner": false,
            "tokenId": "<string>",
            "token": "<string>",
            "expiresAt": 605800000
          }
        }
      ],
      "index": {
        "keys": [
          {
            "name": "email",
            "value": "bob@example.com",
            "scope": "tenant"
          }
        ],
        "facts": []
      }
    },
    {
      "name": "the invited address accepts, taking the groups along",
      "aggregate": "invitation",
      "aggregateId": "i1",
      "tenant": "t1",
      "now": 1000000,
      "given": [
        {
          "type": "InvitationCreated",
          "data": {
            "email": "bob@example.com",
            "groups": [
              {
                "group": "g1",
                "scope": null
              }
            ],
            "owner": false,
            "tokenId": "tk",
            "token": "sec",
            "expiresAt": 2000000
          }
        }
      ],
      "when": {
        "type": "AcceptInvitation",
        "data": {
          "token": "t1.i1.tk.sec",
          "accountId": "a2",
          "email": "Bob@Example.com",
          "newAccount": false
        }
      },
      "then": [
        {
          "type": "InvitationAccepted",
          "data": {
            "tokenId": "tk",
            "accountId": "a2",
            "newAccount": false,
            "groups": [
              {
                "group": "g1",
                "scope": null
              }
            ],
            "owner": false
          }
        }
      ],
      "index": {
        "keys": [],
        "facts": []
      }
    },
