    {
      "name": "a refresh rotates the token: a new generation, the new token's hash",
      "aggregate": "session",
      "aggregateId": "s1",
      "tenant": "platform",
      "now": 1000000,
      "given": [
        {
          "type": "SessionOpened",
          "data": {
            "accountId": "a1",
            "method": "password",
            "factors": [
              "password"
            ],
            "refreshTokenHash": "623eb122f7c6115ddd49a01a83d1367e2f5fdffed24ba88b069c85458dfe645c",
            "ip": null,
            "userAgent": null,
            "at": 900000
          }
        }
      ],
      "when": {
        "type": "RefreshSession",
        "data": {
          "refreshToken": "s1.1.r",
          "newRefreshToken": "s1.2.n"
        }
      },
      "then": [
        {
          "type": "SessionRefreshed",
          "data": {
            "generation": 2,
            "refreshTokenHash": "cdb350a26128d8c1311f44cddc350d79344cd06d4c9d93292da91b7116409534",
            "ip": null,
            "accountId": "a1",
            "at": 1000000
          }
        }
      ]
    },
