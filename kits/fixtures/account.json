    {
      "name": "a person registers: pending, a verification token for 48 hours",
      "aggregate": "account",
      "aggregateId": "a1",
      "tenant": "platform",
      "now": 1000000,
      "given": [],
      "when": {
        "type": "RegisterAccount",
        "data": {
          "email": "  Ann@Example.com ",
          "name": "Ann",
          "password": "correct horse battery"
        }
      },
      "then": [
        {
          "type": "AccountRegistered",
          "data": {
            "email": "ann@example.com",
            "name": "Ann",
            "passwordHash": "<argon2>",
            "verified": false,
            "at": 1000000
          }
        },
        {
          "type": "VerificationRequested",
          "data": {
            "tokenId": "<string>",
            "token": "<string>",
            "email": "ann@example.com",
            "expiresAt": 173800000
          }
        }
      ],
      "index": {
        "keys": [
          {
            "name": "email",
            "value": "ann@example.com",
            "scope": "tenant",
            "subject": "a1"
          }
        ],
        "facts": []
      }
    },
