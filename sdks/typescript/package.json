{
  "name": "@kernable/sdk",
  "version": "0.1.0",
  "description": "kernable SDK for TypeScript: event-sourced business logic in TypeScript on the kernable kernel",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "proto"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist proto && tsc -p tsconfig.build.json && mkdir -p proto/kernable/v1 && cp ../../proto/kernable/v1/kernable.proto proto/kernable/v1/",
    "prepack": "npm run build",
    "postpack": "rm -rf dist proto",
    "check": "tsc && node --test test/*.test.ts ../../examples/shop/*.test.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.0"
  }
}
